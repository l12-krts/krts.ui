{
  "name": "krts.ui",
  "version": "0.1.0",
  "description": "A React UI library built on React Aria and Tailwind CSS, with gesture events (singleTap, doubleTap, hold) and hold-to-confirm controls.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/krts.css",
    "./theme.css": "./src/styles/theme.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/build.css -o dist/krts.css --minify",
    "build:docs": "vite build --config docs/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "keywords": [
    "react",
    "react-aria",
    "tailwindcss",
    "components",
    "ui",
    "gestures",
    "hold-to-confirm"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsup": "^9.0.0",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
